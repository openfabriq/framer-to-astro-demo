---
import SectionHead from './SectionHead.astro';
import Logo from '../Logo.astro';

const others = [
	'Slow communication',
	'Single channel approach',
	'Outdated growth strategies',
	'Lack of industry research',
	'Outsourced to mediocre talent',
];
const us = [
	'Constant, proactive communication',
	'Omni-channel approach',
	'Tailored best-fit solutions',
	'Provides industry specific expertise',
	'Experts with 10+ years of experience',
];
---

<section class="comparison container" id="comparison">
	<SectionHead badge="Comparison">But, why would you want to work <em>with us?</em></SectionHead>
	<div class="cols">
		<div class="col">
			<p class="title other">Other Agencies</p>
			<ul class="card">
				{others.map((t) => <li>{t}</li>)}
			</ul>
		</div>
		<div class="col">
			<h1 class="title brand"><Logo size={36} /><span>Conver<em>sion</em></span></h1>
			<ul class="card us">
				{us.map((t) => <li>{t}</li>)}
			</ul>
		</div>
	</div>
</section>

<style>
	.comparison {
		padding-bottom: 96px;
		scroll-margin-top: 80px;
	}
	.cols {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 48px;
		max-width: 948px;
		margin: 64px auto 0;
	}
	.title {
		margin-top: 0;
		font-weight: 400;
		display: flex;
		justify-content: center;
		align-items: center;
		height: 40px;
		margin-bottom: 28px;
		font-size: 32px;
		letter-spacing: -0.04em;
	}
	.title.other {
		color: var(--muted);
	}
	.brand {
		gap: 10px;
	}
	.brand em {
		font-family: var(--font-serif);
		font-weight: 400;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 20px;
		margin: 0;
		padding: 28px 60px;
		border: 1px solid var(--line);
		border-radius: 24px;
		background: #0d0d0d;
		list-style: none;
		color: var(--muted);
		font-size: 18px;
		line-height: 26px;
	}
	.card.us {
		color: var(--text);
		background: radial-gradient(ellipse 70% 60% at 100% 0%, rgb(220 80 40 / 0.55), transparent 70%), #0d0d0d;
	}
	@media (max-width: 809px) {
		.cols {
			grid-template-columns: 1fr;
			gap: 40px;
		}
		.card {
			padding: 24px 28px;
		}
	}
</style>
