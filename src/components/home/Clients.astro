---
// "You're in good hands" logo strip. Ticker (T09): a CSS-only marquee of the logos twice; under reduced motion one wrapped, still row.
import c1 from '../../assets/logos/client-1.svg?raw';
import c2 from '../../assets/logos/client-2.svg?raw';
import c3 from '../../assets/logos/client-3.svg?raw';
import c4 from '../../assets/logos/client-4.svg?raw';
import c5 from '../../assets/logos/client-5.svg?raw';
import c6 from '../../assets/logos/client-6.svg?raw';

const logos = [c1, c2, c3, c4, c5, c6];
const { title = "You're in good hands:" } = Astro.props;
---

<section class="clients container" id="clients-logos">
	<p>{title}</p>
	<div class="ticker" aria-hidden="true">
		<ul>
			{logos.map((svg) => <li set:html={svg} />)}
		</ul>
		<ul class="copy">
			{logos.map((svg) => <li set:html={svg} />)}
		</ul>
	</div>
</section>

<style>
	.clients {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 32px;
		padding-bottom: 96px;
		color: var(--text);
	}
	p {
		color: var(--muted);
	}
	.ticker {
		display: flex;
		justify-content: center;
		width: 100%;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 24px 64px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.copy {
		display: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		.ticker {
			justify-content: flex-start;
			overflow: hidden;
			mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
		}
		ul,
		.copy {
			display: flex;
			flex-wrap: nowrap;
			flex: none;
			gap: 64px;
			padding-right: 64px;
			animation: ticker 30s linear infinite;
		}
		.ticker:hover ul {
			animation-play-state: paused;
		}
	}
	@keyframes ticker {
		to {
			translate: -100% 0;
		}
	}
	li :global(svg) {
		display: block;
		height: 32px;
		width: auto;
	}
	@media (max-width: 809px) {
		ul,
		.copy {
			gap: 32px;
			padding-right: 32px;
		}
		li :global(svg) {
			height: 26px;
		}
	}
</style>
