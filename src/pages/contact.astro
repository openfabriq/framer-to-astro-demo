---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import { contactFields } from '../lib/forms';
---

<Base
	title="Contact - Conversion"
	description="Ready to scale your brand to new heights? Book a call and let’s discuss how we can bring your vision to life."
	path="/contact"
	cta={false}
>
	<section class="contact container">
		<div class="top-glow" aria-hidden="true"></div>
		<div class="intro">
			<p class="title">Get in <span class="serif">touch.</span></p>
			<p class="lead">
				Ready to scale your brand to new heights? Book a call and let’s discuss how we can bring your vision to life.
			</p>
		</div>
		<Form
			name="contact"
			fields={contactFields}
			submit="Book a call"
			success="Thanks, we got your message and will be in touch soon."
		/>
	</section>
</Base>

<style>
	.contact {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 64px;
		padding-top: 32px;
		padding-bottom: 64px;
	}
	.intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		max-width: 506px;
		text-align: center;
	}
	.title {
		font-size: 38px;
		line-height: 44px;
		letter-spacing: -0.04em;
		font-weight: 500;
	}
	.lead {
		color: var(--muted);
		font-size: 16px;
		line-height: 24px;
	}
	@media (min-width: 810px) {
		.title {
			font-size: 60px;
			line-height: 69px;
		}
		.lead {
			font-size: 18px;
			line-height: 27px;
		}
	}
	/* Desktop only: on phone Framer's page has no glow at the top. */
	.top-glow {
		display: none;
	}
	@media (min-width: 1200px) {
		.top-glow {
			display: block;
			position: absolute;
			top: -120px;
			left: 50%;
			width: min(900px, 100%);
			height: 420px;
			translate: -50% 0;
			background:
				radial-gradient(ellipse 28% 20% at 50% 30%, rgb(255 170 90 / 0.75), transparent 70%),
				radial-gradient(ellipse 22% 16% at 66% 26%, rgb(200 40 70 / 0.45), transparent 70%);
			filter: blur(20px);
			pointer-events: none;
			z-index: -1;
		}
		.contact {
			padding-top: 51px;
		}
		.title {
			font-size: 80px;
			line-height: 88px;
			letter-spacing: -0.04em;
		}
		.lead {
			font-size: 20px;
			line-height: 30px;
		}
	}
</style>
