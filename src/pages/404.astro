---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found - Conversion" description="Looks like you ventured too far little one, let's go home." path="/404" cta={false}>
	<section class="nf">
		<div class="glow" aria-hidden="true"></div>
		<span class="pill">Page not found</span>
		<h2 class="title">You look a little <span class="serif">lost?</span></h2>
		<p class="lead">Looks like you ventured too far little one, let's go home.</p>
		<a class="button" href="/">Go Home</a>
	</section>
</Base>

<style>
	.nf {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
		min-height: 603px;
		padding: 53px var(--gutter) 0;
		text-align: center;
		overflow: hidden;
		box-sizing: border-box;
	}
	.pill {
		margin-bottom: -4px;
		padding: 8px 15px;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 10px;
		background: rgb(255 255 255 / 0.05);
		font-size: 16px;
		line-height: 22px;
	}
	.title {
		font-size: 80px;
		line-height: 1.1;
		letter-spacing: -0.04em;
		font-weight: 500;
	}
	.title .serif {
		letter-spacing: -0.02em;
	}
	.lead {
		max-width: 290px;
		font-size: 20px;
		line-height: 1.5;
		color: var(--muted);
	}
	.glow {
		position: absolute;
		left: 50%;
		bottom: -40px;
		width: min(800px, 100%);
		height: 320px;
		translate: -50% 0;
		background:
			radial-gradient(ellipse 28% 30% at 50% 40%, rgb(255 170 90 / 0.5), transparent 70%),
			radial-gradient(ellipse 30% 40% at 55% 80%, rgb(20 120 190 / 0.4), transparent 70%);
		filter: blur(24px);
		pointer-events: none;
	}
	@media (max-width: 1199.98px) {
		.nf {
			min-height: 560px;
		}
	}
	@media (max-width: 809.98px) {
		.nf {
			min-height: 489px;
		}
		.title {
			font-size: 48px;
		}
	}
</style>
