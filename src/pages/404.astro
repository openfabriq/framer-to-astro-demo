---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found - Conversion" description="Looks like you ventured too far little one, let's go home." path="/404" cta={false}>
	<section class="nf">
		<div class="glow" aria-hidden="true"></div>
		<span class="pill">Page not found</span>
		<h2 class="title">You look a little <span class="serif">lost?</span></h2>
		<p class="lead">Looks like you ventured too far little one, let's go home.</p>
		<a class="button" href="/">Go Home</a>
	</section>
</Base>

<style>
	.nf {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
		min-height: 603px;
		padding: 53px var(--gutter) 0;
		text-align: center;
		overflow: hidden;
		box-sizing: border-box;
	}
	.pill {
		margin-bottom: -4px;
		padding: 8px 15px;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: 10px;
		background: rgb(255 255 255 / 0.05);
		font-size: 16px;
		line-height: 22px;
	}
	.title {
		font-size: 80px;
		line-height: 1.1;
		letter-spacing: -0.04em;
		font-weight: 500;
	}
	.title .serif {
		letter-spacing: -0.02em;
	}
	.lead {
		max-width: 290px;
		font-size: 20px;
		line-height: 1.5;
		color: var(--muted);
	}
	.button {
		font-size: 16px;
	}
	.glow {
		position: absolute;
		left: 50%;
		bottom: -30px;
		width: 600px;
		height: 220px;
		translate: -50% 0;
		background: radial-gradient(ellipse at 50% 85%, #9fd8ea 0%, #fbe3b8 18%, #ff9a55 38%, #7a1010 60%, transparent 75%);
		filter: blur(36px);
		opacity: 0.95;
		pointer-events: none;
	}
	@media (max-width: 1199.98px) {
		.nf {
			min-height: 560px;
		}
		.title {
			font-size: 60px;
		}
		.lead {
			font-size: 18px;
		}
	}
	@media (max-width: 809.98px) {
		.nf {
			min-height: 489px;
		}
		.title {
			font-size: 40px;
		}
		.lead {
			font-size: 16px;
		}
		.glow {
			width: 100%;
			height: 160px;
		}
	}
</style>
